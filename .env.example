# Required: 1Password service account token (read-only access to your vaults)
OP_SERVICE_ACCOUNT_TOKEN=your-service-account-token-here

# Optional: backup destination directory. A leading ~/ is expanded to your home dir.
# Defaults to ~/Library/Mobile Documents/com~apple~CloudDocs/Documents/security/get-reflect-backups
BACKUP_PATH=

# Optional: minimum days between scheduled runs, used for intervals like "every 2 weeks".
# launchd fires on its calendar cadence; the script skips runs until this many days pass.
# 0 (or unset) = run on every cadence. Example: 14 = every 2 weeks. Only applies to
# scheduled runs (the launchd agent passes --scheduled); manual runs always back up.
BACKUP_INTERVAL_DAYS=0
